# Copy to `.env` for local development (never commit real secrets).

# --- Vite app (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: point support-handoff CTA to local Edge Functions (no deploy). Run: npm run functions:serve
# Requires `supabase start` or linked project; JWT must match the Supabase instance you use for auth.
# VITE_LOCAL_SUPPORT_HANDOFF_URL=http://localhost:54321/functions/v1/support-handoff
# Optional app base URL for redirects
# VITE_APP_URL=http://localhost:5173

# EXACT plaintext copy of Supabase secret INTERNAL_FUNCTION_TOKEN (reveal in Dashboard). Never commit a real value.
# Do NOT create INTERNAL_FUNCTION_TOKEN again; do NOT add VITE_INTERNAL_FUNCTION_TOKEN to Supabase Edge secrets.
VITE_INTERNAL_FUNCTION_TOKEN=

# --- Supabase Edge Functions (Dashboard → Project Settings → Edge Functions → Secrets) ---
# INTERNAL_FUNCTION_TOKEN=   # single source of truth; paste same value into VITE_INTERNAL_FUNCTION_TOKEN above for local/build
# OPENAI_API_KEY=            # required for ai-chat (user messages → OpenAI → messages.sender=ai)
# AI_CHAT_MODEL=             # optional; default gpt-4o-mini
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected by Supabase when deployed
#
# Database trigger calls ai-chat via pg_net; set the same INTERNAL_FUNCTION_TOKEN in Postgres, e.g.:
#   ALTER DATABASE postgres SET app.settings.internal_function_token = 'your-token';
# (or your pooler DB name — match how enqueue_send_push_edge is configured)

# --- Server-side / curl only (do NOT use VITE_ prefix; never expose in the frontend bundle) ---
# Partner API key returned once from generate/rotate (stored in DB). Use in Authorization when calling partner-activate.
# PARTNER_API_KEY=
# For curl/postman to partner-activate you also need the same INTERNAL_FUNCTION_TOKEN as header x-internal-token.
